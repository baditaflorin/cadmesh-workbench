#!/bin/sh
set -eu

message_file="$1"
first_line="$(sed -n '1p' "$message_file")"

case "$first_line" in
  feat:\ *|fix:\ *|docs:\ *|chore:\ *|refactor:\ *|test:\ *|ops:\ *|data:\ *)
    exit 0
    ;;
  *)
    printf '%s\n' "Commit message must use Conventional Commits: $first_line" >&2
    exit 1
    ;;
esac

